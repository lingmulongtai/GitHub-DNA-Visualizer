# GitHub Personal Access Token (optional but strongly recommended)
# Without token: 60 requests/hour (unauthenticated GitHub API limit)
# With token:  5000 requests/hour
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=ghp_your_token_here

# Port the backend listens on (default: 3001)
PORT=3001

# Node environment: development | production
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
# Development default: http://localhost:5173,http://localhost:4173
# Production example: CORS_ORIGIN=https://yourdomain.com
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
